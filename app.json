{
  "expo": {
    "name": "antergo-mobile",
    "slug": "antergo-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "antergomobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.antergo.mobile",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.antergo.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      ["expo-image-picker", {"photosPermission": "Izinkan AnterGo memilih foto yang Anda pilih untuk profil, toko, produk, dan dokumen.", "cameraPermission": "Izinkan AnterGo menggunakan kamera untuk mengambil foto dan dokumen.", "microphonePermission": false}],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/logo/antegolight.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/logo/antegodark.png",
            "imageWidth": 200
          }
        }
      ],
      "expo-secure-store",
      ["expo-notifications", { "defaultChannel": "orders", "color": "#208AEF" }],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Izinkan AnterGo menggunakan lokasi Anda untuk memilih pickup dan memperbarui posisi driver saat aplikasi terbuka.",
          "locationAlwaysAndWhenInUsePermission": "Izinkan AnterGo menggunakan lokasi saat aplikasi tidak dibuka agar driver Online tetap dapat menerima dan menjalankan pesanan.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
